# API-ключ xAI (Grok) для вызова облачной модели
XAI_API_KEY=

# Название модели xAI (по умолчанию grok-4.5; имя модели и цены сверить с актуальным списком моделей xAI)
XAI_MODEL=

# Базовый URL OpenAI-совместимого провайдера (по умолчанию https://api.x.ai/v1; для Ollama: http://localhost:11434/v1)
LLM_BASE_URL=

# API-ключ OpenAI-совместимого провайдера (приоритетнее XAI_API_KEY; для localhost/127.0.0.1 не требуется)
LLM_API_KEY=

# Имя модели OpenAI-совместимого провайдера (приоритетнее XAI_MODEL; например, llama3.2:3b, qwen2.5:14b)
LLM_MODEL=

# Таймаут HTTP-запроса к модели в миллисекундах (по умолчанию 60000 для облака, 180000 для localhost)
LLM_TIMEOUT_MS=

# Тариф за 1M входных токенов в USD (по умолчанию 2.0; для бесплатных моделей укажите 0)
LLM_PRICE_INPUT_PER_M=

# Тариф за 1M выходных токенов в USD (по умолчанию 6.0; для бесплатных моделей укажите 0)
LLM_PRICE_OUTPUT_PER_M=

# Максимальное количество токенов в ответе основной оценки (по умолчанию 6000)
XAI_MAX_TOKENS=

# Максимальное количество токенов в ответе AI Judge (по умолчанию 3000)
XAI_JUDGE_MAX_TOKENS=

# URL серверного эндпоинта организаторов для импорта наборов диалогов по group_id
ORGANIZER_API_URL=
